from CORE.brain.kernel import Brain
from CORE.swarm.controller import Swarm
from CORE.memory.system import Memory
from CORE.evolution.engine import Evolution
from CORE.intelligence.engine import Intelligence

from CITY.city import City
from GOVERNANCE.governance import Governance
from MISSIONS.commander import MissionCommander
from TOOLS.registry import ToolRegistry



class JROCMaster:


    def __init__(self):

        self.name = "JROC AI"

        self.version = "v001"

        self.brain = Brain()

        self.swarm = Swarm()

        self.memory = Memory()

        self.evolution = Evolution()

        self.intelligence = Intelligence()

        self.city = City()

        self.governance = Governance()

        self.missions = MissionCommander()

        self.tools = ToolRegistry()



    def boot(self):

        print("[ONLINE] Brain")

        print("[ONLINE] Swarm")

        print("[ONLINE] Memory")

        print("[ONLINE] Evolution")

        print("[ONLINE] Intelligence")

        print("[ONLINE] AI City")

        print("[ONLINE] Governance")

        print("[ONLINE] Missions")

        print("[ONLINE] Tools")



    def status(self):

        print("JROC AI:", self.name)

        print("Version:", self.version)

        print("Status: ONLINE")
